COMPOSE_PROJECT_NAME=giic_asset

# Host ports. Frontend is reachable from other computers; DB and backend bind locally.
FRONTEND_PORT=3000
FRONTEND_BIND_ADDRESS=0.0.0.0
NGINX_CONFIG_PATH=./nginx/default.conf
APP_CLIENT_IP_HOST_PROXY_ENABLED=false
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=9090
DB_BIND_ADDRESS=127.0.0.1
DB_PORT=3907

MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password
MYSQL_DATABASE=asset_management
MYSQL_USER=asset_user
MYSQL_PASSWORD=replace-with-a-random-database-password

JWT_SECRET=replace-with-a-random-64-character-secret
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000
SPRING_JPA_DDL_AUTO=update

# Change localhost to the workstation IP when links in email must be externally reachable.
APP_PUBLIC_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_COOKIE_SECURE=false

GEMINI_API_KEY=

MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
